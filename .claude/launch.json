{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "wrench-works-api/src/WrenchWorks.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "wrench-works-web", "run", "dev"],
      "port": 3000
    }
  ]
}
